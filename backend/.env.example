DATABASE_URL=postgresql+psycopg://catalog:catalog@localhost:5432/catalog
ADMIN_API_KEY=change-me-to-a-strong-secret

# Cloudflare R2 — required for admin image uploads (optional if using image URLs only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public CDN base URL (custom domain or R2 public bucket URL), no trailing slash
R2_PUBLIC_CDN_URL=
# Optional: defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# false = {category}/{subcategory}/{design-number}.webp  |  true = .../image.webp
R2_USE_FIXED_IMAGE_NAME=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
